{
  "name": "@vane.build/audit",
  "version": "0.1.0",
  "description": "Audit your MCP server for cryptographic agent accountability",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vane-audit": "./dist/index.js"
  },
  "exports": {
    ".": {
